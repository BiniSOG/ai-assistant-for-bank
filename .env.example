# Required in production – random string used to sign session state & OTP hashes
APP_SECRET=change-me-to-a-long-random-string

# Optional – enable the LLM (otherwise a rule-based interpreter is used)
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# LLM_PROVIDER=auto        # auto | anthropic | openai | none
# LLM_MODEL=               # defaults: claude-haiku-5-5 / gpt-4o-mini

# Demo: show the OTP on screen because no SMS gateway is connected
DEMO_SHOW_OTP=true
